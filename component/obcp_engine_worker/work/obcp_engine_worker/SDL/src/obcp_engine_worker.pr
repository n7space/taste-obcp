/* CIF PROCESS (250, 150), (150, 75) */
/* CIF Keep Specific Geode _REQSERVER_ 'https://gitlab.esa.int/taste/demo' */
process Obcp_engine_worker;
    /* CIF Keep Specific Geode Partition 'default' */
    /* CIF TEXT (770, 131), (170, 140) */
    DCL id T_Int32;
    /* CIF ENDTEXT */
    /* CIF procedure (617, 10), (143, 35) */
    /* CIF Keep Specific Geode Partition 'default' */
    procedure Initiate_Registration;
        /* CIF START (71, 0), (70, 35) */
        START;
            /* CIF PROCEDURECALL (47, 55), (116, 35) */
            call register_worker;
            /* CIF return (88, 105), (35, 35) */
            return ;
    endprocedure;
    /* CIF START (320, 10), (70, 35) */
    START;
        /* CIF NEXTSTATE (320, 60), (70, 35) */
        NEXTSTATE Wait;
    /* CIF state (450, 10), (70, 35) */
    /* CIF Keep Specific Geode Partition 'default' */
    state Wait;
        /* CIF input (414, 65), (137, 35) */
        input activate_worker(id);
            /* CIF PROCEDURECALL (436, 120), (93, 35) */
            call do_work(id);
            /* CIF PROCEDURECALL (426, 175), (113, 35) */
            call release_worker;
            /* CIF NEXTSTATE (448, 230), (70, 35) */
            NEXTSTATE Wait;
    endstate;
endprocess Obcp_engine_worker;